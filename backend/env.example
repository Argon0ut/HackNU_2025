# Environment Variables Example
# Copy this file to .env and fill in your actual values

# API Keys - Get these from the respective services
# Google Places API: https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# 2GIS API: https://docs.2gis.com/en/api/catalog/overview
TWO_GIS_API_KEY=your_2gis_api_key_here

# Database Configuration
# SQLite - for development (default)
DATABASE_URL=sqlite:///./travel_places.db

# PostgreSQL - for production
# DATABASE_URL=postgresql://username:password@localhost:5432/travel_places

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# Search Settings
DEFAULT_SEARCH_RADIUS=50000
MAX_RESULTS_PER_SOURCE=20

# Classification Settings
CLASSIFICATION_THRESHOLD=0.5
